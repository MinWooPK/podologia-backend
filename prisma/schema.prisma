generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  phone     String?
  address   String?
  avatarUrl String?
  role      Role     @default(CLIENT)
  createdAt DateTime @default(now())
}

model Shop {
  id          String   @id @default(cuid())
  title       String
  subtitle    String?
  description String
  price       Decimal  @db.Decimal(10, 2)
  imageUrl    String?
  inStock     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum Role {
  ADMIN
  CLIENT
}